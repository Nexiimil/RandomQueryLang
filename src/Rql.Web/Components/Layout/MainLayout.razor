@inherits LayoutComponentBase
@implements IDisposable
@inject ProjectSession Projects

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">⚄</span>
            RandomQueryLang
        </a>
        <nav class="tabs">
            <NavLink href="" Match="NavLinkMatch.All">Roll</NavLink>
            <NavLink href="tables">Tables</NavLink>
        </nav>
        <a class="project-switcher" href="projects" title="Switch project">
            @if (Projects.Current is { } project)
            {
                <span class="muted">Project</span> <strong>@project.Name</strong>
            }
            else
            {
                <strong>Choose a project</strong>
            }
            <span aria-hidden="true">▾</span>
        </a>
    </header>

    <main class="content">
        @Body
    </main>

    @if (Projects.Current is { } current)
    {
        <footer class="footer">Tables are saved in <code>@current.Directory</code></footer>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    protected override void OnInitialized() => Projects.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Projects.Changed -= Refresh;
}
